# PowerGrid AI Customer Support — Environment Variables
# -------------------------------------------------------
# Copy this file to .env locally, or set these as environment variables in
# your hosting platform's dashboard (e.g. Render → Environment). Never commit
# a real .env file — it's already in .gitignore.

# Get your FREE Groq API key at: https://console.groq.com (no credit card required)
GROQ_API_KEY=your-groq-api-key-here

# Admin panel password — change this before deploying publicly
ADMIN_PASSWORD=change-me-before-deploying

# Comma-separated list of allowed frontend origins in production, e.g.:
#   CORS_ORIGINS=https://kanea.vercel.app,https://kanea-admin.vercel.app
# Leave unset (or "*") for local dev / first deploy.
CORS_ORIGINS=*
