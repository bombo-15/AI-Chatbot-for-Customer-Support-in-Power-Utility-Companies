# Kanea frontend — Environment Variables
# -------------------------------------------------------
# Only needed for production builds where the backend is hosted separately
# from the frontend (e.g. frontend on Vercel, backend on Render). Leave unset
# for local dev — Vite's dev-server proxy (vite.config.js) handles it instead.
#
# Set these in your hosting platform's dashboard (e.g. Vercel → Project →
# Settings → Environment Variables), not in a committed file.

VITE_API_URL=https://your-backend.onrender.com
VITE_WS_URL=wss://your-backend.onrender.com
